# Copy this file into an MS-DOS project as msdos-project.env and edit it
# for the local machine. Do not commit private licensed toolchains or C_DRIVE
# contents to a public repository.

PROJECT_DIR="/absolute/path/to/project"
DOS_C_DRIVE="/absolute/path/to/C_DRIVE"
DOS_SOURCE_ROOT="/absolute/path/to/source/root"
DOSBOX_BIN="/absolute/path/to/dosbox-x"

# Optional. Defaults to basename "$PROJECT_DIR".
DOS_PROJECT_DIR="PROJECT"

# Commands are executed inside DOSBox after:
#   C: is mounted from DOS_C_DRIVE
#   D: is mounted from DOS_SOURCE_ROOT
#   D:
#   cd \DOS_PROJECT_DIR
BUILD_COMMAND="CALL build.bat"
RUN_COMMAND="PROGRAM.EXE"

# Optional sibling projects/libraries expected under DOS_SOURCE_ROOT.
# Example: SIBLING_DEPS="TEXTUI"
SIBLING_DEPS=""

# Package settings. PACKAGE_FILES is whitespace-delimited and intended for
# 8.3-style DOS project artifacts. PACKAGE_DIRS copies whole directories.
PACKAGE_NAME="program"
PACKAGE_FILES="PROGRAM.EXE README.md LICENSE VERSION"
PACKAGE_DIRS=""

# Optional host transfer location for hardware-test packages.
TRANSFER_DIR=""

# Optional DOSBox tuning.
DOSBOX_MACHINE="svga_s3"
DOSBOX_SCALER="normal2x"
DOSBOX_WINDOWRES="1280x960"

# Optional raw DOSBox config sections inserted before [autoexec].
DOSBOX_EXTRA_CONFIG=""

# Optional DOS commands inserted before BUILD_COMMAND or RUN_COMMAND.
BUILD_DOS_COMMANDS=""
RUN_DOS_COMMANDS=""
